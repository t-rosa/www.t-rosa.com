---
import Container from "../components/container.astro";
import AstroIcon from "../assets/tools/astro.svg";
import CSharpIcon from "../assets/tools/csharp.svg";
import DockerIcon from "../assets/tools/docker.svg";
import EmptyIcon from "../assets/tools/empty.svg";
import VimIcon from "../assets/tools/vim.svg";
import MartinIcon from "../assets/tools/martin.svg";
import GitIcon from "../assets/tools/git.svg";
import MapLibreIcon from "../assets/tools/maplibre.svg";
import OpenLayersIcon from "../assets/tools/openlayers.svg";
import PlaywrightIcon from "../assets/tools/playwright.svg";
import PostGISIcon from "../assets/tools/postgis.svg";
import PostgreSQLIcon from "../assets/tools/postgresql.svg";
import ReactIcon from "../assets/tools/react.svg";
import TypeScriptIcon from "../assets/tools/typescript.svg";
import VitestIcon from "../assets/tools/vitest.svg";
import XUnitIcon from "../assets/tools/xunit.svg";

const tools = [
  {
    title: "TypeScript",
    href: "https://www.typescriptlang.org/",
    Icon: TypeScriptIcon,
  },
  {
    title: "C#",
    href: "https://learn.microsoft.com/dotnet/csharp/",
    Icon: CSharpIcon,
  },
  { title: "React", href: "https://react.dev/", Icon: ReactIcon },
  { title: "Astro", href: "https://astro.build/", Icon: AstroIcon },
  {
    title: "PostgreSQL",
    href: "https://www.postgresql.org/",
    Icon: PostgreSQLIcon,
  },
  { title: "PostGIS", href: "https://postgis.net/", Icon: PostGISIcon },
  { title: "Martin", href: "https://maplibre.org/martin/", Icon: MartinIcon },
  {
    title: "OpenLayers",
    href: "https://openlayers.org/",
    Icon: OpenLayersIcon,
  },
  { title: "MapLibre", href: "https://maplibre.org/", Icon: MapLibreIcon },
  { title: "Vitest", href: "https://vitest.dev/", Icon: VitestIcon },
  {
    title: "Playwright",
    href: "https://playwright.dev/",
    Icon: PlaywrightIcon,
  },
  { title: "XUnit", href: "https://xunit.net/", Icon: XUnitIcon },
  { title: "Docker", href: "https://www.docker.com/", Icon: DockerIcon },
  { title: "Git", href: "https://git-scm.com/", Icon: GitIcon },
  { title: "Vim", href: "https://www.vim.org/", Icon: VimIcon },
  { title: "Undefined", Icon: EmptyIcon },
];
---

<Container class="border-b">
  <section id="tools">
    <div class="border-x">
      <h2 class="font-code p-6 text-center text-3xl sm:text-left">
        Tools<span class="text-primary">[]</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4">
      {tools.map((tool, index) => {
        const Wrapper = tool.href ? "a" : "div";
        const linkProps = tool.href
          ? {
              href: tool.href,
              target: "_blank",
              rel: "noopener noreferrer",
              "aria-label": `${tool.title} official website`,
            }
          : {};
        return (
          <article class="hover:bg-primary/10 group border border-r-0 border-b-0 duration-150 nth-[2n]:border-r md:nth-[2n]:border-r-0 md:nth-[4n]:border-r">
            <Wrapper class="block" {...linkProps}>
              <div class="flex items-center gap-1.5 border-b pr-1.5 sm:gap-3 sm:pr-3">
                <code class="flex border-r p-1.5 sm:p-2.5">
                  <span class="text-primary">[</span>
                  {index}
                  <span class="text-primary">]</span>
                </code>
                <h3 class="text-xs font-bold sm:text-base">{tool.title}</h3>
              </div>
              <div class="text-muted-foreground grid h-32 place-items-center">
                <tool.Icon class="size-16" />
              </div>
            </Wrapper>
          </article>
        );
      })}
    </div>
  </section>
</Container>
